{
  "name": "before-effects",
  "private": true,
  "version": "0.0.0",
  "description": "Before Effects — an AI-native, After Effects–style studio purpose-built for 3D projection mapping",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @be/studio dev",
    "package": "pnpm --filter @be/studio package",
    "build": "pnpm --filter @be/studio build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "register:check": "tsx tools/register/check.ts",
    "register:report": "tsx tools/register/report.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@webgpu/types": "^0.1.74",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
